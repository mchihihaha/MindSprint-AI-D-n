sequenceDiagram
    autonumber
    actor User as Người học
    participant UI as Trình duyệt (script.js, auth.js)
    participant AuthAPI as AuthController
    participant CardAPI as FlashcardsController
    participant ReviewAPI as ReviewController
    participant DB as PostgreSQL
    participant Google as Google Identity Services

    %% ==================== AUTHENTICATION ====================
    rect rgb(240, 248, 255)
    note right of User: ĐĂNG NHẬP / ĐĂNG KÝ
    User->>UI: Nhấn "Đăng nhập" → Nhập email/password
    UI->>AuthAPI: POST /api/auth/login {email, password}
    AuthAPI->>DB: SELECT * FROM Users WHERE Email = @email
    DB-->>AuthAPI: User (PasswordHash)
    AuthAPI->>AuthAPI: Verify PasswordHasher
    AuthAPI-->>UI: {accessToken, refreshToken, user}
    UI->>UI: Lưu token vào localStorage
    UI-->>User: Đăng nhập thành công, chuyển trang chủ
    end

    rect rgb(255, 248, 240)
    note right of User: ĐĂNG NHẬP GOOGLE
    User->>UI: Nhấn "Đăng nhập Google"
    UI->>Google: google.accounts.id.initialize + renderButton
    Google-->>User: Chọn tài khoản Google
    Google-->>UI: credential (JWT ID token)
    UI->>AuthAPI: POST /api/auth/google {credential, nonce}
    AuthAPI->>Google: Verify ID token (GooglePublicKeys)
    Google-->>AuthAPI: Payload {sub, email, name}
    AuthAPI->>DB: SELECT * FROM Users WHERE GoogleSubject = @sub OR Email = @email
    alt Tài khoản đã liên kết
        AuthAPI-->>UI: {accessToken, refreshToken, user}
    else Email đã tồn tại, chưa liên kết
        AuthAPI-->>UI: 409 {code: "google_link_required", message}
        User->>UI: Nhập mật khẩu hiện tại
        UI->>AuthAPI: POST /api/auth/google {credential, nonce, existingPassword}
        AuthAPI->>DB: UPDATE Users SET GoogleSubject = @sub WHERE Email = @email
        AuthAPI-->>UI: {accessToken, refreshToken, user}
    else Tài khoản mới
        AuthAPI->>DB: INSERT INTO Users (Email, DisplayName, GoogleSubject)
        AuthAPI-->>UI: {accessToken, refreshToken, user}
    end
    UI->>UI: Lưu token vào localStorage
    UI-->>User: Đăng nhập thành công
    end

    rect rgb(240, 255, 240)
    note right of User: LÀM MỚI TOKEN (Refresh)
    UI->>AuthAPI: POST /api/auth/refresh {refreshToken} (khi 401)
    AuthAPI->>DB: SELECT * FROM RefreshTokens WHERE Token = @token AND NOT Revoked
    DB-->>AuthAPI: RefreshToken record
    AuthAPI->>DB: UPDATE RefreshTokens SET IsRevoked = true WHERE Token = @token
    AuthAPI->>DB: INSERT INTO RefreshTokens (UserId, Token, ExpiresAt)
    AuthAPI-->>UI: {accessToken, refreshToken}
    UI->>UI: Cập nhật localStorage, retry request gốc
    end

    rect rgb(255, 240, 255)
    note right of User: ĐĂNG XUẤT
    User->>UI: Nhấn "Đăng xuất"
    UI->>AuthAPI: POST /api/auth/logout (JWT)
    AuthAPI->>DB: UPDATE RefreshTokens SET IsRevoked = true WHERE UserId = @uid
    AuthAPI-->>UI: OK
    UI->>UI: Xóa localStorage, reset state
    UI-->>User: Về trang đăng nhập
    end

    %% ==================== FLASHCARD & SRS ====================
    rect rgb(230, 255, 230)
    note right of User: HỌC FLASHCARD (SRS)
    User->>UI: Mở tab "Luyện tập" → Chọn danh mục
    UI->>CardAPI: GET /api/flashcards?category=english (JWT)
    CardAPI->>DB: SELECT f.*, cp.* FROM Flashcards f LEFT JOIN CardProgresses cp ON f.Id = cp.FlashcardId AND cp.UserId = @uid WHERE f.OwnerId IS NULL OR f.OwnerId = @uid
    DB-->>CardAPI: Flashcards + progress
    CardAPI-->>UI: CardResponse[] (kèm SRS status)
    UI-->>User: Hiển thị thẻ học

    User->>UI: Xem câu hỏi → Nhấn "Lật thẻ"
    UI-->>User: Hiển thị đáp án + ví dụ
    User->>UI: Chọn "Nhớ" / "Quên"
    UI->>ReviewAPI: POST /api/review {cardId, remembered} (JWT)
    ReviewAPI->>DB: SELECT * FROM CardProgresses WHERE UserId = @uid AND FlashcardId = @cardId
    DB-->>ReviewAPI: Progress (hoặc null)
    ReviewAPI->>ReviewAPI: Tính SRS (SM-2): repetition, interval, EFactor, nextReviewDate
    ReviewAPI->>DB: UPSERT CardProgresses
    DB-->>ReviewAPI: Progress updated
    ReviewAPI-->>UI: {nextReviewDate, interval, status}
    UI-->>User: Chuyển thẻ tiếp theo
    end

    rect rgb(255, 255, 230)
    note right of User: TẠO THẺ CÁ NHÂN (Optimistic Locking)
    User->>UI: Nhấn "Bộ thẻ mới" → Điền form
    UI->>CardAPI: POST /api/flashcards {category, question, answer, example} (JWT)
    CardAPI->>DB: INSERT INTO Flashcards (OwnerId, Category, Question, Answer, Example, Version=1)
    DB-->>CardAPI: Flashcard mới
    CardAPI-->>UI: {id, version, updatedAt}
    UI->>UI: Cập nhật version cục bộ
    UI-->>User: Thẻ đã tạo

    User->>UI: Sửa thẻ → Lưu
    UI->>CardAPI: PUT /api/flashcards/{externalId} {category, question, answer, example, version} (JWT)
    CardAPI->>DB: SELECT * FROM Flashcards WHERE ExternalId = @id AND OwnerId = @uid
    DB-->>CardAPI: Flashcard (Version hiện tại)
    alt Version khớp
        CardAPI->>DB: UPDATE Flashcards SET ..., Version = Version + 1 WHERE ExternalId = @id
        DB-->>CardAPI: OK
        CardAPI-->>UI: {version, updatedAt}
    else Version không khớp (409 Conflict)
        CardAPI-->>UI: 409 {message, serverVersion, serverCard}
        UI->>User: Hiển thị xung đột, cho chọn: Giữ server / Ghi đè
        alt Chọn Ghi đè
            UI->>CardAPI: PUT /api/flashcards/{externalId} {..., version: serverVersion} (JWT)
            CardAPI->>DB: UPDATE Flashcards SET ..., Version = Version + 1 WHERE ExternalId = @id
            CardAPI-->>UI: {version, updatedAt}
        else Chọn Giữ server
            UI->>UI: Cập nhật UI theo serverCard
        end
    end
    end

    rect rgb(255, 230, 230)
    note right of User: XÓA THẺ (với version check)
    User->>UI: Nhấn xóa thẻ → Xác nhận
    UI->>CardAPI: DELETE /api/flashcards/{externalId}?version=X (JWT)
    CardAPI->>DB: SELECT * FROM Flashcards WHERE ExternalId = @id AND OwnerId = @uid
    DB-->>CardAPI: Flashcard
    alt Version khớp hoặc không gửi version
        CardAPI->>DB: DELETE FROM Flashcards WHERE ExternalId = @id
        CardAPI-->>UI: 204 No Content
    else Version không khớp (409)
        CardAPI-->>UI: 409 {message, serverVersion}
        UI->>User: Hiển thị xung đột
    end
    end