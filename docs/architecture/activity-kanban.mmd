flowchart TD
    %% Activity Diagram: Kanban - Task Management Flow
    Start([Bắt đầu]) --> Login{Kiểm tra\ndăng nhập}
    Login -- Chưa đăng nhập --> ShowLogin[Hiển thị\nhộp thoại đăng nhập]
    ShowLogin --> Login
    Login -- Đã đăng nhập --> LoadBoard[Tải bảng\nKanban từ server]

    LoadBoard --> ViewBoard[Hiển thị 3 cột:\nTodo / Doing / Done]

    ViewBoard --> UserAction{Hành động\nngười dùng}

    UserAction -- Tạo task mới --> CreateTask[Mở hộp thoại\nTạo công việc]
    CreateTask --> FillTask[Nhập tiêu đề,\nmô tả, ưu tiên,\ntrạng thái, hạn chót]
    FillTask --> ValidateTask{Kiểm tra\nbắt buộc}
    ValidateTask -- Thiếu tiêu đề --> CreateTask
    ValidateTask -- Hợp lệ --> SaveTask[Lưu task\nvào DB/server]
    SaveTask --> RenderTask[Hiển thị task\nở cột tương ứng]

    UserAction -- Kéo thả task --> DragStart[Bắt đầu\nkéo task]
    DragStart --> DropTarget[Thả vào cột\nmới/vị trí mới]
    DropTarget --> CalcPos[Tính vị trí\nPosition mới]
    CalcPos --> UpdateTask[Cập nhật\nStatus/Position\nlên server]
    UpdateTask --> ReorderUI[Cập nhật\nthứ tự UI]

    UserAction -- Sửa task --> EditTask[Mở hộp thoại\nChỉnh sửa]
    EditTask --> ModifyFields[Sửa tiêu đề/\nmô tả/ưu tiên/\nhạn chót]
    ModifyFields --> SaveEdit[Lưu thay đổi\nlên server]
    SaveEdit --> RefreshTask[Làm mới\nhiển thị task]

    UserAction -- Xóa task --> ConfirmDelete[Xác nhận\nxóa task]
    ConfirmDelete -- Hủy --> ViewBoard
    ConfirmDelete -- Đồng ý --> DeleteTask[Xóa task\ntừ server]
    DeleteTask --> RemoveUI[Xóa task\nkhỏi giao diện]

    UserAction -- Xem chi tiết --> ViewDetail[Hiển thị modal\nchi tiết task]

    ViewBoard -.-> SyncStatus{Kiểm tra\nđồng bộ}
    SyncStatus -- Có thay đổi\nserver --> ReloadBoard[Tải lại\ntừ server]
    SyncStatus -- Offline --> QueueOffline[Hàng đợi\noffline queue]
    ReloadBoard --> ViewBoard

    RenderTask --> ViewBoard
    ReorderUI --> ViewBoard
    RefreshTask --> ViewBoard
    RemoveUI --> ViewBoard
    ViewDetail --> ViewBoard
    QueueOffline --> ViewBoard

    ViewBoard --> EndAction{Tiếp tục\nquản lý?}
    EndAction -- Có --> UserAction
    EndAction -- Không --> End([Kết thúc])

    subgraph Auth [Xác thực]
        Login
        ShowLogin
    end

    subgraph TaskCRUD [CRUD Task]
        CreateTask
        FillTask
        ValidateTask
