        ConfirmDelete
        DeleteTask
        RemoveUI
        ViewDetail
    end

    subgraph DragDrop [Kéo thả & Sắp xếp]
        DragStart
        DropTarget
        CalcPos
        UpdateTask
        ReorderUI
    end

    subgraph Sync [Đồng bộ & Offline]
        LoadBoard
        SyncStatus
        ReloadBoard
        QueueOffline
    end